# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Windows-specific script files must retain CRLF
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf

# Shell scripts must retain LF
*.sh            text eol=lf

# Documentation & configuration
*.md            text eol=lf
*.json          text eol=lf
*.yaml          text eol=lf
*.yml           text eol=lf
*.toml          text eol=lf
*.xml           text eol=lf

# Source code files
*.go            text eol=lf
*.ts            text eol=lf
*.tsx           text eol=lf
*.js            text eol=lf
*.jsx           text eol=lf
*.py            text eol=lf
*.css           text eol=lf
*.html          text eol=lf
*.svg           text eol=lf

# Binary files
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.woff          binary
*.woff2         binary
*.ttf           binary
*.eot           binary
*.exe           binary
*.dll           binary
*.so            binary
*.dylib         binary
*.zip           binary
*.tar.gz        binary
*.db            binary

# GitHub Linguist Language Detection Overrides
# Vendor & exclude Fleet UI, auxiliary SDK packages, scripts, tests, and styles from repository language statistics
fleet-ui/**             linguist-vendored -linguist-detectable
packages/**             linguist-vendored -linguist-detectable
evals/**                linguist-vendored -linguist-detectable
scratch/**              linguist-vendored -linguist-detectable
scripts/**              linguist-vendored -linguist-detectable
test_*.py               linguist-vendored -linguist-detectable
test_*.txt              linguist-vendored
*.css                   linguist-vendored -linguist-detectable
*.ts                    linguist-vendored -linguist-detectable
*.tsx                   linguist-vendored -linguist-detectable
*.html                  linguist-vendored -linguist-detectable
*.log                   linguist-vendored -linguist-detectable
